# Copy to .env (gitignored) and fill in real values before `docker compose up`.

# Only needed if 8081 is already used by another Airflow instance on your
# machine (e.g. a still-running HW3 container).
AIRFLOW_HOST_PORT=8081

AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Absolute path on THIS machine to the folder holding your Snowflake
# key-pair auth files (rsa_key.p8 / rsa_key.pub). Mounted read-only into the
# Airflow containers at /opt/airflow/snowflake_keys.
SNOWFLAKE_KEY_DIR=/absolute/path/to/your/snowflake_keys

# Passphrase for the encrypted private key above. Read by dbt via
# env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE') in dbt/profiles.yml. This is
# also the value you put in the Airflow Connection's Password field for
# snowflake_conn.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
